{
  "name": "dsh-handsoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HandsOff — 把任务流水线交给 AI 自己排队执行、自己盯进度、自己纠偏；dsh（deepseek-harness）的会话编排插件。Write pipelines up front, let AI run, watch and correct itself.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyerd/dsh-handsoff.git"
  },
  "homepage": "https://github.com/skyerd/dsh-handsoff",
  "bugs": {
    "url": "https://github.com/skyerd/dsh-handsoff/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./host": "./lib/host.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "ai-agent",
    "orchestration",
    "task-queue"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-brand": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
